# Copy to .env and fill in. .env is gitignored — never commit real values.

PORT=8082

# Where the React app runs, for CORS
WEB_ORIGIN=http://localhost:5173

# The Spring Boot backend. The assistant reads watchlists and prices from
# it rather than querying its tables directly.
UPSTREAM_URL=http://localhost:8081

# Must match JWTUtil.SecretKey in the Spring Boot backend, otherwise the
# tokens it issues cannot be verified here. Copy the value from there.
JWT_SECRET=

# The same PostgreSQL the backend uses. This service only creates and
# writes its own tables: portfolio and chat_message.
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=

# Optional. Without it the assistant still answers, from the data it
# gathers, using a built-in summariser instead of a language model.
# Free key from console.groq.com — the request is made here so the key
# never reaches the browser.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
